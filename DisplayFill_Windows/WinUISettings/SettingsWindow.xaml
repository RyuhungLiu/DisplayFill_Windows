<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DisplayFillWindows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DisplayFill Settings">

    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="HDR Fill Light Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Adjust brightness, frame shape, transparency, and behavior." Opacity="0.7" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,20">
            <StackPanel Spacing="22">
                <Expander Header="HDR" IsExpanded="True">
                    <StackPanel Spacing="14" Padding="0,12,0,0">
                        <TextBlock Text="Target Brightness" FontWeight="SemiBold" />
                        <Slider x:Name="TargetNitsSlider" Minimum="80" Maximum="2000" Value="1000" StepFrequency="20" />
                        <TextBlock x:Name="TargetNitsValueText" Text="1000 nits" Opacity="0.7" />
                    </StackPanel>
                </Expander>

                <Expander Header="Frame" IsExpanded="True">
                    <StackPanel Spacing="14" Padding="0,12,0,0">
                        <TextBlock Text="Horizontal / Vertical Margin" FontWeight="SemiBold" />
                        <Slider x:Name="FrameMarginSlider" Minimum="0.03" Maximum="0.18" Value="0.08" StepFrequency="0.01" />
                        <TextBlock x:Name="FrameMarginValueText" Text="8%" Opacity="0.7" />

                        <TextBlock Text="Corner Radius" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="240" Value="60" StepFrequency="5" />
                        <TextBlock x:Name="CornerRadiusValueText" Text="60 px" Opacity="0.7" />

                        <TextBlock Text="Visual Feather" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <Slider x:Name="CornerFeatherSlider" Minimum="0" Maximum="64" Value="24" StepFrequency="1" />
                        <TextBlock x:Name="CornerFeatherValueText" Text="24 px" Opacity="0.7" />
                    </StackPanel>
                </Expander>

                <Expander Header="Window Behavior" IsExpanded="True">
                    <StackPanel Spacing="14" Padding="0,12,0,0">
                        <ToggleSwitch x:Name="PassThroughToggle" Header="Pass-through Mode" IsOn="True" />

                        <TextBlock Text="Hover Alpha" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <Slider x:Name="HoverAlphaSlider" Minimum="0" Maximum="255" Value="40" StepFrequency="1" />
                        <TextBlock x:Name="HoverAlphaValueText" Text="40" Opacity="0.7" />

                        <TextBlock Text="Hover Transition" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <Slider x:Name="HoverTransitionSlider" Minimum="0.05" Maximum="2.0" Value="0.45" StepFrequency="0.05" />
                        <TextBlock x:Name="HoverTransitionValueText" Text="0.45 s" Opacity="0.7" />
                    </StackPanel>
                </Expander>

                <Expander Header="Startup Breathing" IsExpanded="False">
                    <StackPanel Spacing="14" Padding="0,12,0,0">
                        <TextBlock Text="Minimum Brightness" FontWeight="SemiBold" />
                        <Slider x:Name="BreathMinSlider" Minimum="0" Maximum="1" Value="0.2" StepFrequency="0.05" />
                        <TextBlock x:Name="BreathMinValueText" Text="20%" Opacity="0.7" />

                        <TextBlock Text="Duration" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <Slider x:Name="BreathDurationSlider" Minimum="0" Maximum="8" Value="3" StepFrequency="0.25" />
                        <TextBlock x:Name="BreathDurationValueText" Text="3.00 s" Opacity="0.7" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button x:Name="ResetButton" Content="Reset" />
            <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
