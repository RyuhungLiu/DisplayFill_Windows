<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DisplayFill_Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DisplayFill_Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DisplayFill Settings">

    <Grid x:Name="RootGrid" MinWidth="560" MinHeight="640" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="SettingTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="ReadoutTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>

            <Style x:Key="FillSliderStyle" TargetType="Slider">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="120" />
            </Style>

            <Style x:Key="SettingRowStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,8,0,8" />
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,14,14,10" ColumnSpacing="10" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="LogoButton"
                Width="52"
                Height="52"
                Padding="5"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="DisplayFill">
                <Image
                    x:Name="LogoImage"
                    Width="42"
                    Height="42"
                    Source="Assets/Square44x44Logo.scale-200.png"
                    RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="LogoRotateTransform" Angle="0" />
                    </Image.RenderTransform>
                </Image>
            </Button>

            <Grid x:Name="TitleDragArea" Grid.Column="1" Background="Transparent">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AppTitleText" Text="DisplayFill Settings" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AppSubtitleText" Text="HDR screen fill light" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <CommandBar Grid.Column="2" DefaultLabelPosition="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center">
                <AppBarButton x:Name="RefreshButton" Label="Refresh" ToolTipService.ToolTip="Refresh">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="CopyConfigButton" Label="Copy Config" ToolTipService.ToolTip="Copy Config">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="PasteConfigButton" Label="Paste Config" ToolTipService.ToolTip="Paste Config">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE77F;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="HideSettingsButton" Label="Hide Settings" ToolTipService.ToolTip="Hide Settings">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8F2;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ExitEngineButton" Label="Exit Engine" ToolTipService.ToolTip="Exit Engine">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8BB;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar
            x:Name="ConnectionStatusInfoBar"
            Grid.Row="1"
            Margin="24,0,24,12"
            IsOpen="True"
            IsClosable="True"
            Severity="Informational"
            Title="Status"
            Message="Connecting to HDR engine..." />

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="{Binding ViewportWidth, ElementName=SettingsScrollViewer}" MaxWidth="980" Padding="24,0,24,24" Spacing="12">
                <Expander x:Name="HdrExpander" Header="HDR" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Margin="0,8,0,0" Spacing="2">
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TargetBrightnessText" Text="Target Brightness" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="TargetBrightnessDescriptionText" Text="HDR fill brightness" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="TargetNitsSlider" Grid.Column="1" Minimum="80" Maximum="2000" Value="1000" StepFrequency="20" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="TargetNitsValueText" Grid.Column="2" Text="1000 nits" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CenterBoostText" Text="Center Boost" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="CenterBoostDescriptionText" Text="Brighter lamp tube center" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="CenterBoostSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.18" StepFrequency="0.01" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="CenterBoostValueText" Grid.Column="2" Text="18%" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ColorTemperatureText" Text="Color Temperature" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="ColorTemperatureDescriptionText" Text="Cool to warm shift" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="ColorTemperatureSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0" StepFrequency="0.01" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="ColorTemperatureValueText" Grid.Column="2" Text="0" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ColorTintText" Text="Tint" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="ColorTintDescriptionText" Text="Green to magenta shift" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="ColorTintSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0" StepFrequency="0.01" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="ColorTintValueText" Grid.Column="2" Text="0" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ShadowStrengthText" Text="Shadow Strength" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="ShadowStrengthDescriptionText" Text="Inner and outer depth shadow" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="ShadowStrengthSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.28" StepFrequency="0.01" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="ShadowStrengthValueText" Grid.Column="2" Text="28%" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ShadowSizeText" Text="Shadow Size" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="ShadowSizeDescriptionText" Text="Soft shadow spread" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="ShadowSizeSlider" Grid.Column="1" Minimum="0" Maximum="120" Value="42" StepFrequency="1" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="ShadowSizeValueText" Grid.Column="2" Text="42 px" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander x:Name="FrameExpander" Header="Frame" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Margin="0,8,0,0" Spacing="2">
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FrameMarginText" Text="Frame Margin" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="FrameMarginDescriptionText" Text="Border width ratio" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="FrameMarginSlider" Grid.Column="1" Minimum="0.03" Maximum="0.18" Value="0.08" StepFrequency="0.01" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="FrameMarginValueText" Grid.Column="2" Text="8%" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CornerRadiusText" Text="Corner Radius" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="CornerRadiusDescriptionText" Text="Rounded corner size" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="CornerRadiusSlider" Grid.Column="1" Minimum="0" Maximum="240" Value="60" StepFrequency="5" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="CornerRadiusValueText" Grid.Column="2" Text="60 px" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="VisualFeatherText" Text="Visual Feather" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="VisualFeatherDescriptionText" Text="Soft edge transition" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="CornerFeatherSlider" Grid.Column="1" Minimum="0" Maximum="64" Value="24" StepFrequency="1" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="CornerFeatherValueText" Grid.Column="2" Text="24 px" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="OuterCornerRadiusText" Text="Outer Corner" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="OuterCornerRadiusDescriptionText" Text="Rounded outside lamp shape" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="OuterCornerRadiusSlider" Grid.Column="1" Minimum="0" Maximum="240" Value="0" StepFrequency="5" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="OuterCornerRadiusValueText" Grid.Column="2" Text="0 px" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ScreenInsetText" Text="Screen Inset" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="ScreenInsetDescriptionText" Text="Distance from physical screen edge" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="ScreenInsetSlider" Grid.Column="1" Minimum="0" Maximum="240" Value="0" StepFrequency="1" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="ScreenInsetValueText" Grid.Column="2" Text="0 px" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander x:Name="WindowExpander" Header="Window" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Margin="0,8,0,0" Spacing="2">
                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PassThroughText" Text="Pass-through Mode" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="PassThroughDescriptionText" Text="Let mouse input pass through the fill layer" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="PassThroughToggle" Grid.Column="1" Header="" IsOn="True" MinWidth="116" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HoverAlphaText" Text="Hover Alpha" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="HoverAlphaDescriptionText" Text="Opacity while pointer is nearby" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="HoverAlphaSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="40" StepFrequency="1" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="HoverAlphaValueText" Grid.Column="2" Text="40" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HoverTransitionText" Text="Hover Transition" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="HoverTransitionDescriptionText" Text="Fade duration" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <Slider x:Name="HoverTransitionSlider" Grid.Column="1" Minimum="0.05" Maximum="2.0" Value="0.45" StepFrequency="0.05" Style="{StaticResource FillSliderStyle}" />
                            <TextBlock x:Name="HoverTransitionValueText" Grid.Column="2" Text="0.45 s" Style="{StaticResource ReadoutTextStyle}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander x:Name="LanguageExpander" Header="Settings" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Margin="0,12,0,8" Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BackdropText" Text="Acrylic Style" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="BackdropDescriptionText" Text="Window background material" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="BackdropComboBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ComboBoxItem Content="亚克力" Tag="acrylic" />
                                <ComboBoxItem Content="云母" Tag="mica" />
                                <ComboBoxItem Content="纯色" Tag="solid" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ThemeModeText" Text="Theme" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="ThemeModeDescriptionText" Text="Follow system, light, or dark" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeModeComboBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ComboBoxItem Content="跟随系统" Tag="system" />
                                <ComboBoxItem Content="浅色" Tag="light" />
                                <ComboBoxItem Content="深色" Tag="dark" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LanguageText" Text="Display Language" Style="{StaticResource SettingTitleTextStyle}" />
                                <TextBlock x:Name="LanguageDescriptionText" Text="Applies to this window and the HDR engine" Style="{StaticResource SettingDescriptionTextStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                                <ComboBoxItem Content="English (United States)" Tag="en-US" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
